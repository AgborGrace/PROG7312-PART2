<UserControl x:Class="SmartX.Client.Controls.HealthRing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A custom-drawn circular gauge (not a plain ProgressBar). Arc angle and colour come from Percentage. -->
    <Grid>
        <Ellipse Stroke="#2E3648" StrokeThickness="9" Margin="7"/>
        <Path x:Name="ArcPath"
              Stroke="#14B8A6"
              StrokeThickness="9"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              Margin="7"/>
        <TextBlock x:Name="PercentText"
                   Text="100%"
                   FontSize="18" FontWeight="Bold"
                   Foreground="#E7ECF3"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Grid>
</UserControl>
