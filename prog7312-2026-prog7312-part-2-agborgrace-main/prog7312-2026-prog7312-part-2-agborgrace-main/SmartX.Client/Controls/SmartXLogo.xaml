<UserControl x:Class="SmartX.Client.Controls.SmartXLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Vector logo: a hexagon (the mesh cell) with an X and a node on every corner. -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Viewbox x:Name="MarkBox" Width="34" Height="34">
            <Canvas Width="40" Height="40">
                <Path Data="M20,2 L36,11 L36,29 L20,38 L4,29 L4,11 Z"
                      Stroke="#14B8A6" StrokeThickness="2.4" StrokeLineJoin="Round"/>
                <Path Data="M13,14 L27,26 M27,14 L13,26"
                      Stroke="#E7ECF3" StrokeThickness="2.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Ellipse Canvas.Left="17" Canvas.Top="-1" Width="6" Height="6" Fill="#4F8EF7"/>
                <Ellipse Canvas.Left="33" Canvas.Top="8"  Width="6" Height="6" Fill="#14B8A6"/>
                <Ellipse Canvas.Left="33" Canvas.Top="26" Width="6" Height="6" Fill="#14B8A6"/>
                <Ellipse Canvas.Left="17" Canvas.Top="35" Width="6" Height="6" Fill="#4F8EF7"/>
                <Ellipse Canvas.Left="1"  Canvas.Top="26" Width="6" Height="6" Fill="#14B8A6"/>
                <Ellipse Canvas.Left="1"  Canvas.Top="8"  Width="6" Height="6" Fill="#14B8A6"/>
            </Canvas>
        </Viewbox>
        <StackPanel x:Name="Wordmark" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="SMART-X" FontSize="16" FontWeight="Bold" Foreground="#E7ECF3"/>
            <TextBlock Text="MESH GATEWAY" FontSize="9" FontWeight="SemiBold" Foreground="#14B8A6" Margin="0,-1,0,0"/>
        </StackPanel>
    </StackPanel>
</UserControl>
