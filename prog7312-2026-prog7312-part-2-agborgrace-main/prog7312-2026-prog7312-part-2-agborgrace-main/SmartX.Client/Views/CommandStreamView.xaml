<UserControl x:Class="SmartX.Client.Views.CommandStreamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SmartX.Client.Controls"
             xmlns:conv="clr-namespace:SmartX.Client.Converters">

    <UserControl.Resources>
        <conv:StatusToBrushConverter x:Key="StatusBrush"/>
        <conv:SeverityToBrushConverter x:Key="SeverityBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- KPI tile text -->
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMute}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <!-- The selectable frame around each device card -->
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="sel" CornerRadius="13" BorderThickness="2" BorderBrush="Transparent" Margin="0,0,10,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="sel" Property="BorderBrush" Value="#2E8F86"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="sel" Property="BorderBrush" Value="#14B8A6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One live device tile: name, status dot, latest value, sparkline -->
        <DataTemplate x:Key="DeviceCardTemplate">
            <Border Width="228" Height="150" Padding="12,10" CornerRadius="11"
                    Background="{StaticResource BgPanel}" BorderThickness="1.5"
                    BorderBrush="{Binding Status, Converter={StaticResource StatusBrush}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <Ellipse DockPanel.Dock="Right" Width="10" Height="10" VerticalAlignment="Center"
                                 Fill="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextMain}" FontWeight="SemiBold"
                                   FontSize="13" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <TextBlock Grid.Row="1" Text="{Binding Subtitle}" Foreground="{StaticResource TextMute}" FontSize="10.5"
                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>

                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <controls:LiveChart Values="{Binding History}" Margin="0,30,0,0"
                                            LineBrush="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBlock Text="{Binding ValueText}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="10.5" FontWeight="SemiBold" Margin="8,0,0,2" VerticalAlignment="Bottom"
                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="196"/>
        </Grid.RowDefinitions>

        <!-- =================== KPI strip =================== -->
        <UniformGrid Grid.Row="0" Columns="7">
            <Border Style="{StaticResource Card}" Padding="10,8" Margin="0,0,8,0">
                <DockPanel>
                    <controls:HealthRing x:Name="KpiHealthRing" DockPanel.Dock="Left" Width="52" Height="52" Margin="0,0,8,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SYSTEM" Style="{StaticResource KpiLabel}"/>
                        <TextBlock Text="HEALTH" Style="{StaticResource KpiLabel}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="12,9" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="DEVICES ONLINE" Style="{StaticResource KpiLabel}"/>
                    <TextBlock x:Name="KpiOnline" Text="0/0" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="12,9" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="CRITICAL" Style="{StaticResource KpiLabel}"/>
                    <TextBlock x:Name="KpiCritical" Text="0" Style="{StaticResource KpiValue}" Foreground="{StaticResource Danger}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="12,9" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="DISCONNECTED" Style="{StaticResource KpiLabel}"/>
                    <TextBlock x:Name="KpiDisconnected" Text="0" Style="{StaticResource KpiValue}" Foreground="{StaticResource Warn}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="12,9" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="FIFO QUEUE DEPTH" Style="{StaticResource KpiLabel}"/>
                    <TextBlock x:Name="KpiQueue" Text="0" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="12,9" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="TOTAL LOAD" Style="{StaticResource KpiLabel}"/>
                    <TextBlock x:Name="KpiLoad" Text="0 W" Style="{StaticResource KpiValue}" Foreground="{StaticResource InfoBlue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="12,9">
                <StackPanel>
                    <TextBlock Text="DUPLICATES BLOCKED" Style="{StaticResource KpiLabel}"/>
                    <TextBlock x:Name="KpiSuppressed" Text="0" Style="{StaticResource KpiValue}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- =================== search / filter bar =================== -->
        <WrapPanel Grid.Row="1" Margin="0,14,0,0" VerticalAlignment="Center">
            <Grid Width="250" Margin="0,0,8,6">
                <TextBox x:Name="SearchBox" Padding="10,7" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                <TextBlock x:Name="SearchHint" Text="Search devices  (press Enter)" Foreground="{StaticResource TextMute}"
                           FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <Button Content="Search" Style="{StaticResource PrimaryButton}" Padding="16,7" Margin="0,0,16,6" Click="Search_Click"/>

            <TextBlock Text="CATEGORY" Style="{StaticResource KpiLabel}" VerticalAlignment="Center" Margin="0,0,8,6"/>
            <RadioButton x:Name="CatAll" Content="All" Tag="All" GroupName="CatFilter" Style="{StaticResource Chip}" IsChecked="True" Checked="CategoryChip_Checked"/>
            <RadioButton Content="Environmental" Tag="Environmental" GroupName="CatFilter" Style="{StaticResource Chip}" Checked="CategoryChip_Checked"/>
            <RadioButton Content="Power" Tag="PowerConsumption" GroupName="CatFilter" Style="{StaticResource Chip}" Checked="CategoryChip_Checked"/>
            <RadioButton Content="Actuator" Tag="Actuator" GroupName="CatFilter" Style="{StaticResource Chip}" Checked="CategoryChip_Checked"/>

            <TextBlock Text="ALERT STATE" Style="{StaticResource KpiLabel}" VerticalAlignment="Center" Margin="12,0,8,6"/>
            <RadioButton x:Name="StateAll" Content="All" Tag="All" GroupName="StateFilter" Style="{StaticResource Chip}" IsChecked="True" Checked="StateChip_Checked"/>
            <RadioButton Content="Normal" Tag="Normal" GroupName="StateFilter" Style="{StaticResource Chip}" Checked="StateChip_Checked"/>
            <RadioButton Content="Warning" Tag="Warning" GroupName="StateFilter" Style="{StaticResource Chip}" Checked="StateChip_Checked"/>
            <RadioButton Content="Critical" Tag="Critical" GroupName="StateFilter" Style="{StaticResource Chip}" Checked="StateChip_Checked"/>
            <RadioButton Content="Disconnected" Tag="Disconnected" GroupName="StateFilter" Style="{StaticResource Chip}" Checked="StateChip_Checked"/>
        </WrapPanel>

        <TextBlock x:Name="ConnectionText" Grid.Row="2" Visibility="Collapsed" Foreground="{StaticResource Danger}"
                   FontSize="12" Margin="0,2,0,2" TextWrapping="Wrap"/>

        <!-- =================== main area =================== -->
        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="372"/>
            </Grid.ColumnDefinitions>

            <!-- live device cards -->
            <ListBox x:Name="DeviceList" Grid.Column="0" Background="Transparent" BorderThickness="0"
                     ItemTemplate="{StaticResource DeviceCardTemplate}"
                     ItemContainerStyle="{StaticResource CardItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="DeviceList_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <!-- right column: override, suggestions, insights -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">

                    <!-- manual override -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="MANUAL OVERRIDE" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="SelectedNameText" Text="No device selected - click a device card" Foreground="{StaticResource TextMain}"
                                       FontSize="13" FontWeight="SemiBold" Margin="0,6,0,8" TextWrapping="Wrap"/>

                            <controls:LiveChart x:Name="DetailChart" Height="64" Margin="0,0,0,10"/>

                            <UniformGrid Columns="3">
                                <Button x:Name="BtnOn" Content="Turn ON" Style="{StaticResource PrimaryButton}" Padding="8,8" Margin="0,0,6,0" IsEnabled="False" Click="On_Click"/>
                                <Button x:Name="BtnOff" Content="Turn OFF" Style="{StaticResource SecondaryButton}" Padding="8,8" Margin="3,0,3,0" IsEnabled="False" Click="Off_Click"/>
                                <Button x:Name="BtnToggle" Content="Toggle" Style="{StaticResource SecondaryButton}" Padding="8,8" Margin="6,0,0,0" IsEnabled="False" Click="Toggle_Click"/>
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <Button x:Name="BtnShutAll" Content="Shut down ALL" Style="{StaticResource DangerButton}" Padding="8,8" Margin="0,0,4,0" Click="ShutAll_Click"/>
                                <Button x:Name="BtnUndo" Content="Undo last command" Style="{StaticResource SecondaryButton}" Padding="8,8" Margin="4,0,0,0" Click="Undo_Click"/>
                            </UniformGrid>

                            <TextBlock x:Name="CommandStatusText" Foreground="{StaticResource TextMute}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>

                            <TextBlock Text="COMMAND HISTORY (top = next undo)" Style="{StaticResource KpiLabel}" Margin="0,12,0,4"/>
                            <ItemsControl x:Name="HistoryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextMain}" FontSize="11.5" Margin="0,1" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoHistoryText" Text="No commands yet." Style="{StaticResource Muted}" FontSize="11.5"/>
                        </StackPanel>
                    </Border>

                    <!-- suggested actions -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="SUGGESTED ACTIONS" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,8"
                                       Text="Learned from your own searches and commands."/>
                            <ItemsControl x:Name="SuggestedList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgInput}" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"
                                                           Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                                                <Button Content="{Binding ActionLabel}" Style="{StaticResource PrimaryButton}" Padding="12,5" FontSize="12"
                                                        HorizontalAlignment="Left" Margin="0,8,0,0"
                                                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"
                                                        Click="ApplyInsight_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoSuggestionsText" Style="{StaticResource Muted}" FontSize="11.5"
                                       Text="No suggestions yet. Search for devices and issue commands - after the same alert has been followed by the same action twice, it will be suggested here."/>
                        </StackPanel>
                    </Border>

                    <!-- automated insights -->
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="AUTOMATED INSIGHTS" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,8"
                                       Text="Faulty devices, out-of-range readings and trends - highlighted before you search."/>
                            <ItemsControl x:Name="InsightList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgInput}" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"
                                                           Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                                                <Button Content="{Binding ActionLabel}" Style="{StaticResource SecondaryButton}" Padding="12,5" FontSize="12"
                                                        HorizontalAlignment="Left" Margin="0,8,0,0"
                                                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"
                                                        Click="ApplyInsight_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoInsightsText" Text="All devices look healthy." Style="{StaticResource Muted}" FontSize="11.5"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- =================== bottom row: alerts | processing log | test lab =================== -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ALERTS (duplicates are blocked by the HashSet)" Style="{StaticResource SectionTitle}" FontSize="10" Margin="0,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AlertList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Margin="0,0,6,0" VerticalAlignment="Top"
                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Foreground="{StaticResource TextMute}" FontSize="10.5" Margin="8,0,0,0" VerticalAlignment="Top"/>
                                        <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextMain}" FontSize="11.5" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PROCESSING LOG (critical alerts jump the FIFO queue)" Style="{StaticResource SectionTitle}" FontSize="10" Margin="0,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ProcessingList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" FontSize="11" Margin="0,1" TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="14,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="TEST LAB" Style="{StaticResource SectionTitle}" FontSize="10" Margin="0,0,0,6"/>
                    <TextBlock x:Name="LabStatusText" DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"
                               Text="Simulated devices send real HTTP packets to the API."/>
                    <WrapPanel>
                        <Button x:Name="SimButton" Content="Start simulator" Style="{StaticResource PrimaryButton}" Padding="10,6" FontSize="11.5" Margin="0,0,6,6" Click="Sim_Click"/>
                        <Button x:Name="BurstButton" Content="Queue burst + critical" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="11.5" Margin="0,0,6,6" Click="Burst_Click"/>
                        <Button x:Name="SpikeButton" Content="Power spike" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="11.5" Margin="0,0,6,6" Click="Spike_Click"/>
                        <Button x:Name="DropoutButton" Content="Drop out selected" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="11.5" Margin="0,0,6,6" IsEnabled="False" Click="Dropout_Click"/>
                        <Button x:Name="ReportDisconnectButton" Content="Report disconnect" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="11.5" Margin="0,0,6,6" IsEnabled="False" Click="ReportDisconnect_Click"/>
                        <Button x:Name="ScenarioButton" Content="Train the engine" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="11.5" Margin="0,0,6,6" Click="Scenario_Click"/>
                    </WrapPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
