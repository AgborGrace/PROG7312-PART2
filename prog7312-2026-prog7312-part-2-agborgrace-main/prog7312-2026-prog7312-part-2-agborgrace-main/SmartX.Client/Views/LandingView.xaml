<UserControl x:Class="SmartX.Client.Views.LandingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SmartX.Client.Controls">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B0E14" Offset="0"/>
                <GradientStop Color="#0E2229" Offset="0.55"/>
                <GradientStop Color="#0B0E14" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== top navigation ===== -->
        <Grid Grid.Row="0" Margin="48,22,48,0">
            <controls:SmartXLogo HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Platform" Foreground="{StaticResource TextMute}" FontSize="13" Margin="0,0,26,0" VerticalAlignment="Center"/>
                <TextBlock Text="Telemetry" Foreground="{StaticResource TextMute}" FontSize="13" Margin="0,0,26,0" VerticalAlignment="Center"/>
                <TextBlock Text="Security" Foreground="{StaticResource TextMute}" FontSize="13" Margin="0,0,26,0" VerticalAlignment="Center"/>
                <Button Content="Sign in" Style="{StaticResource GhostButton}" Padding="20,8" Click="SignIn_Click"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="48,8,48,36">

                <!-- ===== hero ===== -->
                <Grid MinHeight="440">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,28,0">
                        <Border Background="#123B3A" CornerRadius="14" Padding="12,5" HorizontalAlignment="Left" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="LIVE MESH TELEMETRY PLATFORM" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Every sensor." FontSize="48" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                        <TextBlock Text="One resilient mesh." FontSize="48" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,-8,0,0"/>

                        <TextBlock TextWrapping="Wrap" FontSize="15" LineHeight="23" Margin="0,20,0,0" MaxWidth="520"
                                   Foreground="{StaticResource TextMute}"
                                   Text="Smart-X connects ESP32 sensors, smart plugs and actuators into a self-healing mesh. It ingests telemetry in real time, escalates critical alerts the instant they happen, and suggests your next action before you go looking for it."/>

                        <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                            <Button Content="Sign in to the gateway" Style="{StaticResource PrimaryButton}" Padding="26,13" FontSize="14" Click="SignIn_Click"/>
                            <Button Content="Create an account" Style="{StaticResource GhostButton}" Padding="22,13" FontSize="14" Margin="12,0,0,0" Click="Register_Click"/>
                        </StackPanel>

                        <TextBlock Text="Secured with Firebase Authentication  |  .NET 10 API  |  Real-time command stream"
                                   Foreground="{StaticResource TextMute}" FontSize="11" Margin="0,22,0,0"/>
                    </StackPanel>

                    <!-- animated mesh network -->
                    <controls:MeshHero Grid.Column="1" MinHeight="400" Margin="0,8,0,8"/>
                </Grid>

                <!-- ===== feature cards ===== -->
                <TextBlock Text="WHAT SMART-X DOES" Style="{StaticResource SectionTitle}" Margin="0,30,0,14"/>

                <UniformGrid Columns="3">
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="&#x1F4E1;" FontSize="28"/>
                            <TextBlock Text="Sensor data ingestion" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="0,10,0,6"/>
                            <TextBlock Style="{StaticResource Muted}"
                                       Text="Register devices one by one or import a whole fleet from a text file. Every packet is validated and stored in order."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="5,0,5,0">
                        <StackPanel>
                            <TextBlock Text="&#x26A1;" FontSize="28"/>
                            <TextBlock Text="Real-time command stream" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="0,10,0,6"/>
                            <TextBlock Style="{StaticResource Muted}"
                                       Text="Critical alerts jump the queue. Switch pumps and relays with a one-step undo, and watch live gauges for every node."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="&#x1F9E0;" FontSize="28"/>
                            <TextBlock Text="Predictive actions" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="0,10,0,6"/>
                            <TextBlock Style="{StaticResource Muted}"
                                       Text="Smart-X learns from your searches and commands, then proposes the next step when the same problem returns."/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ===== how data flows ===== -->
                <TextBlock Text="HOW DATA FLOWS" Style="{StaticResource SectionTitle}" Margin="0,30,0,14"/>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource Card}" Padding="16,10"><TextBlock Text="ESP32 sensors" Foreground="{StaticResource TextMain}" FontWeight="SemiBold"/></Border>
                    <TextBlock Text="&#x2192;" Foreground="{StaticResource Accent}" FontSize="20" Margin="12,0" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource Card}" Padding="16,10"><TextBlock Text="Mesh network" Foreground="{StaticResource TextMain}" FontWeight="SemiBold"/></Border>
                    <TextBlock Text="&#x2192;" Foreground="{StaticResource Accent}" FontSize="20" Margin="12,0" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource Card}" Padding="16,10"><TextBlock Text="Gateway API" Foreground="{StaticResource TextMain}" FontWeight="SemiBold"/></Border>
                    <TextBlock Text="&#x2192;" Foreground="{StaticResource Accent}" FontSize="20" Margin="12,0" VerticalAlignment="Center"/>
                    <Border Style="{StaticResource Card}" Padding="16,10"><TextBlock Text="Operator dashboard" Foreground="{StaticResource TextMain}" FontWeight="SemiBold"/></Border>
                </StackPanel>

                <TextBlock Text="Smart-X Gateway  |  PROG7312 Portfolio of Evidence  |  The Independent Institute of Education"
                           Foreground="{StaticResource TextMute}" FontSize="11" Margin="0,36,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
