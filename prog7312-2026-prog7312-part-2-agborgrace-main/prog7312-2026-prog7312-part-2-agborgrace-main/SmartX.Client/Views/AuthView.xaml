<UserControl x:Class="SmartX.Client.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SmartX.Client.Controls">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B0E14" Offset="0"/>
                <GradientStop Color="#0E2229" Offset="0.6"/>
                <GradientStop Color="#0B0E14" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="520"/>
        </Grid.ColumnDefinitions>

        <!-- left: brand panel -->
        <Grid Grid.Column="0" Margin="48,28,24,28">
            <controls:SmartXLogo HorizontalAlignment="Left" VerticalAlignment="Top"/>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Operators only." FontSize="38" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                <TextBlock Text="Sign in to your gateway." FontSize="38" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="0,18,0,0" MaxWidth="440"
                           Text="Access to telemetry, manual overrides and alert history is limited to authenticated users. Accounts are managed by Firebase Authentication — passwords are never stored by Smart-X."/>

                <StackPanel Margin="0,26,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Every API call carries a verified identity token" Foreground="{StaticResource TextMain}" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Sessions refresh automatically while you work" Foreground="{StaticResource TextMain}" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Every manual command is logged with who issued it" Foreground="{StaticResource TextMain}" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- right: sign-in card -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,36,48,36" Padding="32" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock x:Name="HeadingText" Text="Welcome back" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                <TextBlock x:Name="SubheadingText" Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Sign in with your operator account."/>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <RadioButton x:Name="SignInChip" Content="Sign in" GroupName="AuthMode" Style="{StaticResource Chip}" IsChecked="True" Checked="Mode_Checked"/>
                    <RadioButton x:Name="RegisterChip" Content="Create account" GroupName="AuthMode" Style="{StaticResource Chip}" Checked="Mode_Checked"/>
                </StackPanel>

                <Border x:Name="ConfigBanner" Visibility="Collapsed" Background="#3A2A12" CornerRadius="8" Padding="12,10" Margin="0,6,0,0">
                    <TextBlock Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap"
                               Text="Firebase is not configured yet. Paste your Firebase Web API key into client-settings.json (see the README), then restart the app."/>
                </Border>

                <TextBlock Text="EMAIL" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="EmailBox"/>

                <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="PasswordInput"/>

                <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
                    <TextBlock Text="CONFIRM PASSWORD" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="ConfirmInput"/>
                </StackPanel>

                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0" Foreground="{StaticResource TextMute}"/>

                <Button x:Name="SubmitButton" Content="Sign in" Style="{StaticResource PrimaryButton}" Padding="16,12"
                        Margin="0,16,0,0" IsDefault="True" Click="Submit_Click"/>

                <Grid Margin="0,14,0,0">
                    <Button x:Name="ForgotButton" Content="Forgot password?" Style="{StaticResource GhostButton}" BorderThickness="0"
                            Foreground="{StaticResource TextMute}" HorizontalAlignment="Left" Padding="0,4" Click="Forgot_Click"/>
                    <Button Content="Back to home" Style="{StaticResource GhostButton}" BorderThickness="0"
                            Foreground="{StaticResource TextMute}" HorizontalAlignment="Right" Padding="0,4" Click="Back_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
